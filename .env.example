# ── Database ────────────────────────────────────────────────
POSTGRES_USER=vml_user
POSTGRES_PASSWORD=vml_pass
POSTGRES_DB=vml_db
DATABASE_URL=postgresql://vml_user:vml_pass@localhost:5432/vml_db

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Client (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:4000
